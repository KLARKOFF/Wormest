# Скопируйте в .env и поменяйте пароль.
# В пароле используйте только латинские буквы, цифры и дефис: он подставляется в URL подключения.
POSTGRES_PASSWORD=change-me-please

# Порт, на котором будет открыто приложение
APP_PORT=8000

# true — если приложение открыто через HTTPS (например, через reverse proxy)
COOKIE_SECURE=false

# Когда все нужные аккаунты созданы, можно закрыть регистрацию: false
REGISTRATION_OPEN=true
